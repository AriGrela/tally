# All optional. Tally works without any server-side secrets:
# visitors bring their own key in the studio (it never leaves their browser except per request).

# "House" keys: unlocked only with the access code below, so you can use your own
# credits from any device without exposing them to visitors.
TALLY_ACCESS_CODE=
ANTHROPIC_API_KEY=
TALLY_COMPAT_API_KEY=
TALLY_COMPAT_BASE_URL=
TALLY_COMPAT_MODEL=

# Raises the GitHub API limit for the github_* tools (60 -> 5000 requests/hour).
GITHUB_TOKEN=

# Extra hosts the send_webhook tool may call, comma-separated (wildcards allowed),
# e.g. your self-hosted n8n: n8n.example.com
TALLY_WEBHOOK_HOSTS=

# Local/self-hosted only: allow OpenAI-compatible base URLs on private networks
# (Ollama on localhost or a Tailscale IP). Never enable on a public deployment.
TALLY_ALLOW_LOCAL_MODELS=

# Canonical URL for metadata and the MCP snippet (Vercel sets its own automatically).
NEXT_PUBLIC_SITE_URL=
